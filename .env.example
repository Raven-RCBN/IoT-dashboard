NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/plantation_tracker

# Optional. Defaults to 3600 seconds when omitted.
COUNT_NEXT_UPLOAD_SECONDS=3600

# Optional token for admin-only helper routes.
ADMIN_API_TOKEN=change-this-admin-token

# Use true for local testing. Use false if the dashboard is exposed publicly.
DASHBOARD_PUBLIC=true
DASHBOARD_PUBLIC_HOSTS=localhost,127.0.0.1
DASHBOARD_USER=change-this-dashboard-user
DASHBOARD_PASSWORD=change-this-dashboard-password
DASHBOARD_SESSION_SECRET=change-this-long-random-session-secret

# Required only when running scripts/seedDevices.js.
CNT00002_TOKEN=change-this-device-token
CNT00003_TOKEN=change-this-device-token
HRV00002_TOKEN=change-this-device-token
HRV00003_TOKEN=change-this-device-token
